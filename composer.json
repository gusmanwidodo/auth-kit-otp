{
    "name": "gusmanwidodo/auth-kit-otp",
    "description": "One-time password (OTP) plugin for Auth-Kit. Adds /auth-kit/otp/* endpoints and a code store.",
    "keywords": ["laravel", "auth-kit", "otp", "one-time-password", "2fa", "authentication"],
    "homepage": "https://github.com/gusmanwidodo/auth-kit-otp",
    "license": "MIT",
    "authors": [
        {
            "name": "Gusman Widodo",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "gusmanwidodo/auth-kit": "^0.1",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gusmanwidodo\\AuthKitOtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gusmanwidodo\\AuthKitOtp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gusmanwidodo\\AuthKitOtp\\OtpServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
